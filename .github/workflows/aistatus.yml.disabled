name: 生成 AI 信息屏

# 说明：
#  · 定时在白天每 30 分钟生成一张新图，提交到 docs/ 由 GitHub Pages 托管
#  · Kindle 只负责下载这张 PNG，所以家里不需要任何常开的服务器
#  · 公开仓库的 Actions 额度不限量，这个工作流一年也花不了钱
#
# 注意：GitHub 的定时任务用 UTC 时间。下面写的是 UTC，
# 换算成北京时间就是 06:00 ~ 22:59（也就是 config.yaml 里配的白天时段）。

on:
  schedule:
    - cron: "*/30 22-23,0-14 * * *"
  push:
    branches: [main]
    paths:
      - "dashboard/**"
      - ".github/workflows/**"
  workflow_dispatch:

# 同一时间只跑一个，避免上一轮还没推完下一轮又开始了
concurrency:
  group: aistatus
  cancel-in-progress: false

permissions:
  contents: write      # 需要提交生成的图片
  models: read         # GitHub Models 的免费推理必需这一条，不能少

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: 拉取仓库
        uses: actions/checkout@v4

      - name: 准备 Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: dashboard/requirements.txt

      - name: 安装中文字体
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq fonts-noto-cjk fonts-wqy-microhei
          fc-cache -f > /dev/null 2>&1
          echo "----- 可用中文字体 -----"
          fc-list :lang=zh file family | head -n 10

      - name: 安装 Python 依赖
        run: pip install -r dashboard/requirements.txt

      - name: 生成信息屏图片
        id: gen
        env:
          # GITHUB_TOKEN 自带 models:read 权限，用来调 GitHub Models 生成早报摘要，
          # 不需要另外申请任何 API Key
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          TZ: Asia/Shanghai
        run: python dashboard/generate.py --config dashboard/config.yaml

      - name: 输出结果摘要
        if: always()
        run: |
          echo "## AI 信息屏生成结果" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- 图片大小：${{ steps.gen.outputs.size_kb }} KB" >> $GITHUB_STEP_SUMMARY
          echo "- 早报摘要：${{ steps.gen.outputs.digest_ai == 'true' && 'AI 生成' || '降级为原始标题' }}" >> $GITHUB_STEP_SUMMARY
          if [ -f docs/debug.json ]; then
            echo "" >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
            python -c "import json;d=json.load(open('docs/debug.json',encoding='utf-8'));print(json.dumps(d['counts'],ensure_ascii=False,indent=2))" >> $GITHUB_STEP_SUMMARY || true
            echo '```' >> $GITHUB_STEP_SUMMARY
          fi

      - name: 提交并推送
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add docs/dashboard.png docs/index.html
          if git diff --cached --quiet; then
            echo "图片没有变化，跳过提交"
          else
            git commit -m "chore: 更新信息屏 $(TZ=Asia/Shanghai date '+%Y-%m-%d %H:%M')"
            # 并发场景下远端可能已经有新提交，先 rebase 再推
            git pull --rebase --autostash origin ${GITHUB_REF_NAME} || true
            git push
          fi
